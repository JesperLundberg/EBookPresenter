@model EBookViewModel

@{
    ViewData["Title"] = "Home Page";
}

<h1>All EBooks</h1>

<p>
    <a asp-controller="Home" asp-action="ToggleSortOrder">Sort by: @(string.IsNullOrEmpty(Model.SortOrder) ? "alphabetic" : Model.SortOrder)</a>
</p>

<table border="0" cellpadding="4" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th align="left">Date</th>
            <th align="left">Title</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var eBook in Model.EBooks)
        {
            <tr>
                <td>@eBook.CreatedDate.ToString("yyyy-MM-dd")</td>
                <td><a asp-controller="SpecificEBook" asp-action="Index" asp-route-path="@eBook.Path">@eBook.Title</a></td>
            </tr>
        }
    </tbody>
</table>
